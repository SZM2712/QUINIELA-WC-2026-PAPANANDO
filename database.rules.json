{
  "rules": {
    ".read": "auth != null",
    ".write": false,

    "pap26_admins": {
      ".write": false
    },

    "pap26_idx": {
      ".write": "auth != null"
    },
    "pap26_c_$code": {
      ".write": "auth != null"
    },
    "pap26_u_$name": {
      ".write": "auth != null"
    },
    "pap26_comments": {
      "$matchKey": {
        "$commentId": {
          ".write": "auth != null"
        }
      }
    },

    "pap26_real_results": {
      ".write": "auth != null && root.child('pap26_admins').child(auth.uid).val() === true"
    },
    "pap26_official_podio": {
      ".write": "auth != null && root.child('pap26_admins').child(auth.uid).val() === true"
    },
    "pap26_third_override": {
      ".write": "auth != null && root.child('pap26_admins').child(auth.uid).val() === true"
    },
    "pap26_stats_history": {
      ".write": "auth != null && root.child('pap26_admins').child(auth.uid).val() === true"
    }
  }
}
